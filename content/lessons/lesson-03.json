{
  "id": "lesson-03",
  "contentVersion": "2026-09-12.1",
  "title": "Consoantes que abrem palavras",
  "objective": "Ao ouvir o nome comum de uma consoante frequente (M, S, P, L), a pessoa seleciona a letra correspondente.",
  "prerequisites": ["lesson-02"],
  "estimatedMinutes": 5,
  "intro": {
    "key": "lesson-03/intro",
    "text": "Agora quatro letras que aparecem no começo de muitas palavras: M, S, P e L. Ouça o nome da letra e toque nela."
  },
  "outro": { "key": "shared/outro", "text": "Você chegou ao fim desta lição. Muito bem pelo seu esforço!" },
