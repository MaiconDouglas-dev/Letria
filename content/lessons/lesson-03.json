    {
      "id": "lesson-03-a1",
      "type": "listen-and-select",
      "narratesTarget": true,
      "prompt": { "key": "lesson-03/a1-prompt", "text": "Toque na letra ême, de mamãe." },
      "options": [
        { "id": "m", "label": "M", "audio": { "key": "sounds/m", "text": "ême" } },
        { "id": "s", "label": "S", "audio": { "key": "sounds/s", "text": "ésse" } },
        { "id": "p", "label": "P", "audio": { "key": "sounds/p", "text": "pê" } },
        { "id": "l", "label": "L", "audio": { "key": "sounds/l", "text": "éle" } }
      ],
      "correctOptionId": "m",
      "hints": [
        { "level": 1, "audio": { "key": "lesson-03/a1-dica1", "text": "É a letra que começa a palavra mamãe." } },
        { "level": 2, "audio": { "key": "shared/dica-elimina", "text": "Vou esconder duas opções. Agora ficou mais fácil." }, "eliminateOptions": ["s", "l"] }
