{
  "id": "lesson-02",
  "contentVersion": "2026-09-12.1",
  "title": "Os sons das vogais",
  "objective": "Ao ouvir o som de uma vogal, a pessoa seleciona a letra correspondente entre quatro opções.",
  "prerequisites": ["lesson-01"],
  "estimatedMinutes": 5,
  "intro": {
    "key": "lesson-02/intro",
    "text": "Agora vamos conhecer as letras que chamamos de vogais. Você vai ouvir um som e tocar na letra que faz esse som."
  },
  "outro": { "key": "shared/outro", "text": "Você chegou ao fim desta lição. Muito bem pelo seu esforço!" },
  "activities": [
    {
      "id": "lesson-02-a1",
      "type": "listen-and-select",
      "narratesTarget": true,
      "prompt": { "key": "lesson-02/a1-prompt", "text": "Toque na letra que faz o som: á." },
      "options": [
        { "id": "a", "label": "A", "image": "✈️", "audio": { "key": "sounds/a", "text": "á" } },
        { "id": "e", "label": "E", "image": "⭐", "audio": { "key": "sounds/e", "text": "é" } },
        { "id": "i", "label": "I", "image": "⛪", "audio": { "key": "sounds/i", "text": "í" } },
        { "id": "o", "label": "O", "image": "👓", "audio": { "key": "sounds/o", "text": "ó" } }
      ],
      "correctOptionId": "a",
      "hints": [
        { "level": 1, "audio": { "key": "shared/dica-ouca", "text": "Escute de novo com calma." } },
        { "level": 2, "audio": { "key": "shared/dica-elimina", "text": "Vou esconder duas opções. Agora ficou mais fácil." }, "eliminateOptions": ["i", "o"] }
